NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webhook_dispatcher
# Required in production. Send this as: Authorization: Bearer <key>
DISPATCH_API_KEY=replace-with-a-long-random-secret
# Local testing only: allows webhook destinations such as http://localhost:4000
ALLOW_PRIVATE_DESTINATIONS=true
# Worker configuration
WORKER_POLL_INTERVAL_MS=500
WEBHOOK_TIMEOUT_MS=10000
MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=2000
# Per destination domain token bucket
RATE_LIMIT_CAPACITY=5
RATE_LIMIT_REFILL_PER_SECOND=1
