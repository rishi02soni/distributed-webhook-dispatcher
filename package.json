{
  "name": "distributed-webhook-dispatcher",
  "version": "1.0.0",
  "private": true,
  "description": "Persistent asynchronous webhook dispatcher with retries and per-domain token-bucket rate limiting",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/start-production.js",
    "worker": "node src/worker.js",
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker.js",
    "test": "node --test",
    "db:migrate": "node scripts/migrate.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.1"
  }
}
